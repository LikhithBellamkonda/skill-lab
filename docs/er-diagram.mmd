erDiagram
  USERS ||--o{ ITEMS : reports
  CATEGORIES ||--o{ ITEMS : classifies
  USERS ||--o{ CLAIMS : submits
  ITEMS ||--o{ CLAIMS : receives
  ITEMS ||--o{ MATCHES : participates
  USERS ||--o{ NOTIFICATIONS : receives
  USERS ||--o{ AUDITLOGS : acts

  USERS {
    ObjectId _id
    string full_name
    string email
    string password_hash
    string role
    boolean is_active
  }
  CATEGORIES {
    ObjectId _id
    string name
    string description
  }
  ITEMS {
    ObjectId _id
    ObjectId user_id
    ObjectId category_id
    string type
    string status
    Point location
    string verification_hint
  }
  CLAIMS {
    ObjectId _id
    ObjectId item_id
    ObjectId user_id
    string status
    string evidence
  }
  MATCHES {
    ObjectId _id
    ObjectId item1_id
    ObjectId item2_id
    number score
    string status
  }
  NOTIFICATIONS {
    ObjectId _id
    ObjectId user_id
    boolean is_read
  }
  AUDITLOGS {
    ObjectId _id
    ObjectId actor_user_id
    string action
    string entity_type
    string entity_id
  }
