{
  "name": "smart-lost-found",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Lost & Found - a MongoDB-backed campus lost and found application",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm run start --workspace server",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{server,client}/**/*.{js,jsx,json,css}\" \"*.{md,json}\"",
    "db:seed": "node server/src/scripts/seed.js",
    "db:setup": "npm run db:seed",
    "db:status": "node server/src/scripts/db-status.js",
    "admin:create": "node server/src/scripts/create-admin.js",
    "deploy:prepare": "node server/src/scripts/deploy-prepare.js",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^10.0.6",
    "dotenv": "^16.6.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
